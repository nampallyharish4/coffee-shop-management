# Database Configuration
# IMPORTANT: Never commit actual credentials to version control
# For development: useSSL=false is acceptable
# For production: Use useSSL=true&requireSSL=true&verifyServerCertificate=true
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/coffee_shop?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# JWT Configuration
# IMPORTANT: Generate a strong random secret at least 32 characters long
# You can generate one using: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_at_least_32_characters_long

# JPA Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# CORS Configuration (comma-separated list of allowed origins)
# Example: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
