# Production Environment Configuration
# Copy this file to .env.prod and update with your production values
# IMPORTANT: Keep this file secure and never commit it to version control

# MySQL Database Configuration - MUST CHANGE FOR PRODUCTION
MYSQL_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD_NOW
MYSQL_DATABASE=coffee_shop
MYSQL_USER=coffee_admin
MYSQL_PASSWORD=CHANGE_THIS_DB_PASSWORD_NOW
MYSQL_PORT=3306

# Backend Configuration
BACKEND_PORT=8081

# JWT Secret - MUST CHANGE FOR PRODUCTION
# Generate a new secret: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_JWT_SECRET_GENERATE_WITH_OPENSSL_RAND

# Database Schema Management - Use 'validate' for production
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Frontend Configuration
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443

# API URL for Frontend
# For production, use your domain or configure nginx proxy
REACT_APP_API_URL=/api

# Optional: Email Configuration (if implementing email features)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# Optional: Redis Cache (if implementing caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
